{
  "name": "soliderplate",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "paraglide": "paraglide-js compile --project ./project.inlang --outdir ./src/paraglide --emit-ts-declarations",
    "dev": "vp dev",
    "build": "bun run paraglide && tsc -b && vp build",
    "postinstall": "bun run paraglide",
    "preview": "vp preview",
    "tsc": "tsc -b",
    "lint": "vp lint --type-aware",
    "format": "vp fmt",
    "prepare": "vp config"
  },
  "dependencies": {
    "@corvu/calendar": "^0.1.2",
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource-variable/fraunces": "^5.3.0",
    "@formisch/solid": "^1.0.0",
    "@kobalte/core": "^0.13.13",
    "@tanstack/query-core": "^5.101.4",
    "@tanstack/query-db-collection": "^1.2.5",
    "@tanstack/solid-db": "^0.2.35",
    "@tanstack/solid-query": "^5.101.4",
    "@tanstack/solid-router": "^1.170.29",
    "cva": "^1.0.0-beta.8",
    "dayjs": "^1.11.23",
    "es-toolkit": "^1.51.0",
    "ky": "^2.0.2",
    "solid-js": "^1.9.15",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "valibot": "^1.4.2"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@iconify-json/lucide": "^1.2.124",
    "@iconify/tailwind4": "^1.2.3",
    "@inlang/paraglide-js": "^2.24.1",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/router-plugin": "^1.168.34",
    "@types/node": "^26.2.0",
    "eslint-plugin-solid": "^0.15.0",
    "solid-devtools": "^0.34.5",
    "typescript": "^7.0.2",
    "vite": "npm:@voidzero-dev/vite-plus-core@^0.2.9",
    "vite-plugin-solid": "^2.11.14",
    "vite-plus": "^0.2.9"
  },
  "overrides": {
    "cva": "^1.0.0-beta.8",
    "vite": "npm:@voidzero-dev/vite-plus-core@latest",
    "vitest/vite": "npm:@voidzero-dev/vite-plus-core@latest",
    "fast-uri": "^4.1.2",
    "svgo": "^4.0.2",
    "brace-expansion": "^5.0.9",
    "postcss": "^8.5.25",
    "nanoid": "^3.3.18",
    "js-yaml": "^5.2.3"
  },
  "devEngines": {
    "packageManager": {
      "name": "bun",
      "version": "1.3.14",
      "onFail": "download"
    }
  }
}
