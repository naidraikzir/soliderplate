{
  "name": "soliderplate",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "paraglide": "paraglide-js compile --project ./project.inlang --outdir ./src/paraglide --emit-ts-declarations",
    "dev": "vp dev",
    "build": "bun run paraglide && tsc -b && vp build",
    "postinstall": "bun run paraglide",
    "preview": "vp preview",
    "tsc": "tsc -b",
    "lint": "vp lint --type-aware",
    "format": "vp fmt",
    "prepare": "vp config"
  },
  "dependencies": {
    "@corvu/calendar": "^0.1.2",
    "@faker-js/faker": "^10.6.0",
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource-variable/fraunces": "^5.3.0",
    "@formisch/solid": "^1.3.0",
    "@kobalte/core": "^0.13.14",
    "@tanstack/query-core": "^5.107.1",
    "@tanstack/query-db-collection": "^1.5.2",
    "@tanstack/solid-db": "^1.0.0-rc.1.5",
    "@tanstack/solid-query": "^5.107.1",
    "@tanstack/solid-router": "^1.170.43",
    "cva": "^1.0.0-beta.12",
    "dayjs": "^1.11.23",
    "es-toolkit": "^1.53.2",
    "ky": "^2.2.0",
    "solid-js": "^1.9.19",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.5",
    "tw-animate-css": "^1.4.0",
    "valibot": "^1.5.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@iconify-json/lucide": "^1.2.154",
    "@iconify/tailwind4": "^1.2.3",
    "@inlang/paraglide-js": "^2.27.0",
    "@tailwindcss/vite": "^4.3.5",
    "@tanstack/router-plugin": "^1.169.0",
    "@types/node": "^26.6.6",
    "eslint-plugin-solid": "^0.19.0",
    "msw": "^3.0.5",
    "solid-devtools": "^0.34.5",
    "typescript": "^7.0.2",
    "vite": "npm:@voidzero-dev/vite-plus-core@^1.6.0",
    "vite-plugin-solid": "^2.11.16",
    "vite-plus": "^1.6.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "bun",
      "version": "1.3.14",
      "onFail": "download"
    }
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
